{
  "name": "jml-fixture-live-export",
  "active": true,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "wf-local-2"
  },
  "nodes": [
    {
      "name": "Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "node-local-0"
    },
    {
      "name": "Start",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.JML_API_URL }}/v1/runs",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "kind",
              "value": "pipeline"
            }
          ]
        },
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "JML Toolkit API",
          "id": "cred-local-httpHeaderAuth"
        }
      },
      "id": "node-local-1"
    },
    {
      "name": "Wait",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        400,
        0
      ],
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "node-local-2",
      "webhookId": "webhook-local-1"
    },
    {
      "name": "Poll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.JML_API_URL }}/v1/runs/{{ $('Start').item.json.body.runId }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "JML Toolkit API",
          "id": "cred-local-httpHeaderAuth"
        }
      },
      "id": "node-local-3"
    },
    {
      "name": "Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        800,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "terminal",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 202,
              "operator": {
                "type": "number",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-local-4"
    },
    {
      "name": "Post",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [
        1000,
        0
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SLACK_JML_CHANNEL_ID }}"
        },
        "text": "=run {{ $('Poll').item.json.body.runId }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "credentials": {
        "slackApi": {
          "name": "JML Slack Alerts",
          "id": "cred-local-slackApi"
        }
      },
      "id": "node-local-5"
    },
    {
      "name": "Delivered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "slack-ok",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-local-6"
    },
    {
      "name": "Stop",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        1400,
        -200
      ],
      "parameters": {
        "errorMessage": "the summary was not delivered"
      },
      "id": "node-local-7"
    },
    {
      "name": "Done",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1400,
        0
      ],
      "parameters": {},
      "id": "node-local-8"
    }
  ],
  "connections": {
    "Trigger": {
      "main": [
        [
          {
            "node": "Start",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start": {
      "main": [
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait": {
      "main": [
        [
          {
            "node": "Poll",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poll": {
      "main": [
        [
          {
            "node": "Finished?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Finished?": {
      "main": [
        [
          {
            "node": "Post",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Wait",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post": {
      "main": [
        [
          {
            "node": "Delivered?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Delivered?": {
      "main": [
        [
          {
            "node": "Done",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Stop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "id": "wf-local-1",
  "versionId": "version-local-1",
  "createdAt": "2020-01-01T00:00:00.000Z",
  "updatedAt": "2020-01-02T00:00:00.000Z",
  "triggerCount": 3,
  "tags": [
    {
      "id": "tag-1",
      "name": "lifecycle"
    }
  ],
  "meta": {
    "instanceId": "instance-local-1",
    "templateCredsSetupCompleted": true
  },
  "pinData": {
    "Poll": [
      {
        "json": {
          "body": {
            "ok": true
          }
        }
      }
    ]
  },
  "staticData": {
    "node:Poll": {
      "lastLeaver": "jane.doe@example.com",
      "lastRun": "2020-01-02"
    }
  },
  "shared": [
    {
      "role": "workflow:owner"
    }
  ]
}
