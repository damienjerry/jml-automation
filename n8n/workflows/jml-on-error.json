{
  "name": "jml-on-error",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 300,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "name": "A toolkit workflow failed",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "notes": "The other four workflows name this one as their error workflow. Without it a red execution is visible only to somebody already looking at n8n, which is nobody at 07:00.",
      "parameters": {}
    },
    {
      "name": "Post the failure",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [220, 0],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "The message names the workflow, the node and the execution, because an alert that only says something failed sends the reader back to n8n to find out what.",
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SLACK_JML_CHANNEL_ID }}"
        },
        "text": "=JML workflow failed: {{ $json.workflow.name }}\nnode: {{ $json.execution.lastNodeExecuted }}\nerror: {{ $json.execution.error.message }}\nexecution: {{ $json.execution.id }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "credentials": {
        "slackApi": {
          "name": "JML Slack Alerts"
        }
      }
    },
    {
      "name": "Slack accepted the post?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0],
      "notes": "An alert path that cannot report its own failure is not an alert path. This assertion turns a rejected alert into a red execution, which is the last signal available before silence.",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "slack-ok-true",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Stop: the alert was not delivered",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [660, -200],
      "parameters": {
        "errorMessage": "=A toolkit workflow failed and the alert was rejected: {{ JSON.stringify($json).slice(0, 400) }}"
      }
    },
    {
      "name": "Alert delivered",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [660, 0],
      "parameters": {}
    }
  ],
  "connections": {
    "A toolkit workflow failed": {
      "main": [[{ "node": "Post the failure", "type": "main", "index": 0 }]]
    },
    "Post the failure": {
      "main": [[{ "node": "Slack accepted the post?", "type": "main", "index": 0 }]]
    },
    "Slack accepted the post?": {
      "main": [
        [{ "node": "Alert delivered", "type": "main", "index": 0 }],
        [{ "node": "Stop: the alert was not delivered", "type": "main", "index": 0 }]
      ]
    }
  }
}
