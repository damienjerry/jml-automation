{
  "name": "jml-doctor",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "jml-on-error",
    "executionTimeout": 600,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "nodes": [
    {
      "name": "Every day at 06:45",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "notes": "Fifteen minutes before the pipeline, so a credential that has stopped working is known before the run that needs it rather than after.",
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "45 6 * * *"
            }
          ]
        }
      }
    },
    {
      "name": "Check the sidecar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0],
      "notes": "The doctor makes a live call per credential and per authorised scope, so it takes a minute or two. It answers 200 when every probe passes and 503 when one does not, which are both answers.",
      "parameters": {
        "method": "GET",
        "url": "={{ $env.JML_API_URL }}/v1/doctor",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-JML-Actor",
              "value": "=n8n:{{ $workflow.name }}#{{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "JML Toolkit API"
        }
      }
    },
    {
      "name": "Doctor answered?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [440, 0],
      "notes": "A sidecar that cannot answer at all is the one failure the doctor cannot report on itself, so it is separated from a failing probe.",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "answered-200",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            },
            {
              "id": "answered-503",
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 503,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      }
    },
    {
      "name": "Stop: the sidecar did not answer",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [660, -380],
      "parameters": {
        "errorMessage": "=The doctor route did not answer (HTTP {{ $json.statusCode }}). The sidecar is unreachable or the bearer token is wrong, so today's pipeline run will fail the same way."
      }
    },
    {
      "name": "Every probe passing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [660, 0],
      "notes": "Nothing is posted while everything passes. A daily post saying the same thing is read for a week and ignored thereafter, which is how a genuinely new failure goes unnoticed. It does repeat daily while a probe stays broken, which is the honest trade until the sidecar reports whether the table has changed since the last check.",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "doctor-ok-true",
              "leftValue": "={{ $json.body.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Nothing to report",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [880, -200],
      "parameters": {}
    },
    {
      "name": "Post the failing probes",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [880, 0],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "notes": "Each failing row carries its own remediation and documentation anchor, so the message says what to do rather than only what broke.",
      "parameters": {
        "resource": "message",
        "operation": "post",
        "authentication": "accessToken",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $env.SLACK_JML_CHANNEL_ID }}"
        },
        "text": "=jml-doctor: {{ $('Check the sidecar').item.json.body.report.failures.length }} check(s) failed, mode {{ $('Check the sidecar').item.json.body.report.mode }}\n{{ $('Check the sidecar').item.json.body.report.rows.filter(r => !r.ok).map(r => r.name + ': ' + r.detail + ' (see ' + r.docsAnchor + ')').join('\\n') }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "credentials": {
        "slackApi": {
          "name": "JML Slack Alerts"
        }
      }
    },
    {
      "name": "Slack accepted the post?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1100, 0],
      "notes": "The post comes before the failure is raised, so a rejected post cannot hide the thing it was reporting.",
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "slack-ok-true",
              "leftValue": "={{ $json.ok }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "name": "Stop: a probe is failing",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1320, 0],
      "notes": "Reached only when the table was posted successfully. The execution still goes red, because a failing credential is a failure whether or not the message about it arrived.",
      "parameters": {
        "errorMessage": "=A doctor probe is failing: {{ $('Check the sidecar').item.json.body.report.failures.join('; ').slice(0, 400) }}"
      }
    },
    {
      "name": "Stop: the probe table was not delivered",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1320, -200],
      "parameters": {
        "errorMessage": "=A doctor probe is failing and the table was not delivered: {{ JSON.stringify($json).slice(0, 400) }}"
      }
    }
  ],
  "connections": {
    "Every day at 06:45": {
      "main": [[{ "node": "Check the sidecar", "type": "main", "index": 0 }]]
    },
    "Check the sidecar": {
      "main": [[{ "node": "Doctor answered?", "type": "main", "index": 0 }]]
    },
    "Doctor answered?": {
      "main": [
        [{ "node": "Every probe passing?", "type": "main", "index": 0 }],
        [{ "node": "Stop: the sidecar did not answer", "type": "main", "index": 0 }]
      ]
    },
    "Every probe passing?": {
      "main": [
        [{ "node": "Nothing to report", "type": "main", "index": 0 }],
        [{ "node": "Post the failing probes", "type": "main", "index": 0 }]
      ]
    },
    "Post the failing probes": {
      "main": [[{ "node": "Slack accepted the post?", "type": "main", "index": 0 }]]
    },
    "Slack accepted the post?": {
      "main": [
        [{ "node": "Stop: a probe is failing", "type": "main", "index": 0 }],
        [{ "node": "Stop: the probe table was not delivered", "type": "main", "index": 0 }]
      ]
    }
  }
}
