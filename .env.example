# GENERATED FILE. Edit src/config/schema.ts and run `npm run generate`.
#
# Names only. This file never carries a value, so it is safe to commit and
# safe to read in a pull request. Copy it to .env and fill it in there.
#
# A name marked SECRET is referenced from jml.config.yaml as env:NAME.

# org.name: Organisation name, used in notifications and the leaver auto-reply.
ORG_NAME=

# org.primaryDomain: The domain a canonical address is expressed in.
ORG_PRIMARY_DOMAIN=

# org.aliasDomains: Comma-separated domains that route to the same mailboxes. Two systems keyed on different domains for one person is how identity joins silently diverge.
# default: []
ORG_ALIAS_DOMAINS=

# org.timezone: IANA zone as Region/City, such as Europe/London. ALL date-only arithmetic happens in it; never in UTC.
ORG_TIMEZONE=

# org.itTeamSignature: Sign-off line on notifications sent to a person.
IT_TEAM_SIGNATURE=

# mode: dry-run plans and reports without touching a provider. It is the default, and the demo runs in it.
# default: "dry-run"
JML_MODE=

# armedActions: Which actions may really happen. An action absent from this list records not_armed rather than running, so arming happens one action at a time.
# default: []
JML_ARMED_ACTIONS=

# mail.senderMailbox: The mailbox outbound mail is sent AS. Delegated authority is granted for this address specifically.
MAIL_SENDER_MAILBOX=

# mail.bcc: Addresses blind-copied on every notification.
# default: []
MAIL_BCC=

# mail.managerOnDay0: Tell the leaver's manager on day 0 that offboarding has started.
# default: true
MAIL_MANAGER_ON_DAY0=

# hris.adapter: Which HR source to read: HiBob, a JSON fixture, a CSV file, or a Google Sheet shared with the service account.
HRIS_ADAPTER=

# hris.minPlausibleHeadcount: REQUIRED, no default. A snapshot smaller than this aborts the run. A truncated read looks exactly like a company where everybody left, and the cost of that mistake is suspending the whole staff, so an adopter states their own floor rather than inheriting a guess.
HRIS_MIN_PLAUSIBLE_HEADCOUNT=

# hris.exitRenamePatterns: Regular expressions matching the address an HR system renames a leaver to. A match means the address is an alias on the same person, never a new identity.
# default: ["\\+(exit|leaver)@"]
HRIS_EXIT_RENAME_PATTERNS=

# hris.hibob.baseUrl: HR API base URL.
# default: "https://api.hibob.com/v1"
HIBOB_BASE_URL=

# hris.hibob.serviceUserId: Service user id, as a secret reference.
# SECRET: the value belongs in your secret manager, not in a repository.
HIBOB_SERVICE_USER_ID=

# hris.hibob.serviceToken: Service user token, as a secret reference.
# SECRET: the value belongs in your secret manager, not in a repository.
HIBOB_SERVICE_TOKEN=

# hris.hibob.pageSize: Page size for the paged read.
# default: 200
HIBOB_PAGE_SIZE=

# hris.fixture.path: JSON file holding the snapshot.
HRIS_FIXTURE_PATH=

# hris.table.path: The CSV file, for adapter csv.
# default: null
HRIS_TABLE_PATH=

# hris.table.spreadsheetId: The sheet id from its URL, for adapter sheet. Share the sheet with the service account address as a viewer.
# default: null
HRIS_TABLE_SPREADSHEET_ID=

# hris.table.range: The tab name, or an A1 range such as People!A1:Z. The first row is the headings.
# default: "People"
HRIS_TABLE_RANGE=

# hris.table.dateFormat: The one format every date in the table is in. A value in any other format refuses the whole read.
# default: "YYYY-MM-DD"
HRIS_TABLE_DATE_FORMAT=

# hris.table.maxAgeHours: Refuse a table last changed longer ago than this. For a sheet it needs the read-only Drive scope as the service account.
# default: null
HRIS_TABLE_MAX_AGE_HOURS=

# store.adapter (sqlite): Local SQLite: the default people store.
STORE_ADAPTER=

# store.path (sqlite): Database file.
# default: "./data/jml.sqlite"
STORE_SQLITE_PATH=

# store.token (notion): Internal integration token, as a secret reference.
# SECRET: the value belongs in your secret manager, not in a repository.
NOTION_API_KEY=

# store.peopleDatabaseId (notion): Database id holding one row per person.
NOTION_PEOPLE_DB_ID=

# store.readOnly (notion): Never write to the database. Reads, counts, `jml store verify` and every dry run work; every write refuses; a missing property is read as empty rather than added. For a database another automation owns, such as a shadow run beside a live estate.
# default: false
NOTION_READ_ONLY=

# store.spreadsheetId (sheets): Spreadsheet id.
PEOPLE_SHEET_ID=

# store.tab (sheets): Worksheet name.
# default: "People"
PEOPLE_SHEET_TAB=

# identity.adapter: `jumpcloud` (setup 1.0a) puts a JumpCloud account in front of Google. `none` (setup 1.0b) makes the Google account the only account: day 0 closes it with a random password and a sign-out, starters get their temporary password on Google, and there is no device inventory, so every deletion says none was checked.
# default: "jumpcloud"
IDENTITY_ADAPTER=

# identity.jumpcloud.baseUrl: Some tenants answer only on the console host and return 404 on the other one for every request, valid key or not.
# default: "https://console.jumpcloud.com/api"
JUMPCLOUD_BASE_URL=

# identity.jumpcloud.apiKey: Organisation API key, as a secret reference.
# SECRET: the value belongs in your secret manager, not in a repository.
JUMPCLOUD_API_KEY=

# identity.jumpcloud.consoleUrl: Where a starter signs in for the first time. Printed in the password and welcome messages.
# default: "https://console.jumpcloud.com"
JUMPCLOUD_CONSOLE_URL=

# identity.jumpcloud.poolUserEmail: Spares account a returned device is rebound to. Null disables the rebind.
# default: null
JUMPCLOUD_POOL_USER_EMAIL=

# google.serviceAccountJson: The whole service account key file, as a secret reference. `file:/path/to/key.json` is the usual form.
# SECRET: the value belongs in your secret manager, not in a repository.
GOOGLE_SERVICE_ACCOUNT_JSON=

# google.adminEmail: The admin this service account impersonates for directory, licensing and transfer calls.
GOOGLE_ADMIN_EMAIL=

# google.customer: List by customer, never by one domain: a per-domain list silently misses every account on an alias domain.
# default: "my_customer"
GOOGLE_CUSTOMER=

# google.licenceProductIds: Products searched when revoking a licence.
# default: ["Google-Apps"]
GOOGLE_LICENCE_PRODUCT_IDS=

# google.driveTransfer.applications: What is handed over. The application id is resolved at run time, never hard-coded.
# default: ["drive"]
GOOGLE_TRANSFER_APPLICATIONS=

# google.driveTransfer.privacyLevels: Which files move.
# default: ["PRIVATE","SHARED"]
GOOGLE_TRANSFER_PRIVACY_LEVELS=

# google.driveTransfer.fallbackRecipient: Used when no manager resolves. Null parks the row for a person to decide.
# default: null
GOOGLE_TRANSFER_FALLBACK_RECIPIENT=

# google.driveTransfer.pollTimeoutMinutes: How long one run waits before leaving the transfer to be re-polled by the next run.
# default: 30
GOOGLE_TRANSFER_POLL_TIMEOUT_MIN=

# leaver.terminationLookbackDays: A leaving date older than this parks the row instead of acting on it. This is the backstop against a stale record being treated as a fresh departure.
# default: 60
TERMINATION_LOOKBACK_DAYS=

# leaver.maxDay0PerRun: Circuit breaker. More day-0 candidates than this aborts the WHOLE run rather than processing the first few, because a sudden crowd of leavers is a data fault far more often than a redundancy round.
# default: 5
LEAVER_MAX_DAY0_PER_RUN=

# leaver.maxAttemptsPerLeg: After this many failures a leg parks the row for a person.
# default: 6
LEAVER_MAX_ATTEMPTS_PER_LEG=

# leaver.transferDay: Days after suspension that files are handed over.
# default: 6
OFFBOARD_TRANSFER_DAY=

# leaver.deleteDay: Days after suspension that accounts are deleted.
# default: 7
OFFBOARD_DELETE_DAY=

# leaver.deletion: `never` suspends and hands over, then keeps both accounts. Day 7 is not scheduled at all: no run deletes a retained leaver, reads their devices, or reports a failure over them; the report counts them as retained. Close a row by hand with `jml leaver tombstone` once you have dealt with the accounts. `never` refuses `delete` in armedActions, because the two contradict each other.
# default: "automatic"
LEAVER_DELETION=

# leaver.revokeLicences: `all`, or a list of SKU ids to revoke.
# default: "all"
LEAVER_REVOKE_LICENCES=

# leaver.deleteGoogleUser: False stops at suspension so the mailbox can be archived by hand.
# default: true
LEAVER_DELETE_GOOGLE_USER=

# leaver.requireOperatorAck: Require a human acknowledgement before any deletion.
# default: false
LEAVER_REQUIRE_OPERATOR_ACK=

# leaver.requireTransferBeforeDelete: Refuse deletion until the file handover is confirmed complete.
# default: true
LEAVER_REQUIRE_TRANSFER_BEFORE_DELETE=

# leaver.autoReply.subject: Placeholders: displayName, orgName, managerName, managerEmail.
# default: "${displayName} has left ${orgName}"
LEAVER_AUTOREPLY_SUBJECT=

# leaver.autoReply.bodyHtml: Same placeholders as the subject.
# default: "<p>${displayName} no longer works at ${orgName}.</p><p>Please contact ${managerName} at ${managerEmail}.</p>"
LEAVER_AUTOREPLY_BODY=

# joiner.leadWorkingDays: Activate this many working days before the start date, so the temporary password reaches the manager in time. Weekends and the dates in holidays are skipped.
# default: 3
JOINER_LEAD_WORKING_DAYS=

# joiner.graceDays: Somebody who started more than this many days ago with no activation recorded is an existing employee, not a starter: not selected, not announced, and their manager is not nudged. On a fresh people store every employee looks like a starter otherwise. Name a person with --hris-id to activate them regardless.
# default: 7
JOINER_GRACE_DAYS=

# joiner.maxActivationsPerRun: More candidates than this are reported and held for the next run rather than all being activated at once. A crowd of joiners is a data fault far more often than a hiring round.
# default: 5
JOINER_MAX_PER_RUN=

# joiner.gate: What has to happen before an eligible person is activated. none: nothing. manual: somebody runs `jml joiner approve`. ticket: a ticket raised on the starter form opens it, through the configured ticketing adapter (Suptask ships), and `jml joiner approve` still works by hand.
# default: "none"
JOINER_GATE=

# joiner.targetOrgUnitPath: Google organisational unit to move the account into on activation, for example the one whose sign-in is delegated to the identity provider. Blank skips the move.
# default: ""
JOINER_TARGET_OU=

# joiner.licence.skuId: The SKU to assign on activation. Blank skips licensing, and the welcome email is withheld if the mailbox is not ready anyway.
# default: ""
JOINER_LICENCE_SKU=

# joiner.itSupportEmail: Always receives a copy of the temporary password, so it is never lost when the other recipients are unusable.
# default: null
JOINER_IT_SUPPORT_EMAIL=

# ticketing.adapter: Which ticketing system. none disables every ticketing feature.
# default: "none"
TICKETING_ADAPTER=

# ticketing.suptask.baseUrl: Public API base URL.
# default: "https://public-api-prod.suptask.com/api/v2/public"
SUPTASK_BASE_URL=

# ticketing.suptask.apiToken: Workspace API token, as a secret reference.
# SECRET: the value belongs in your secret manager, not in a repository.
# default: null
SUPTASK_API_TOKEN=

# ticketing.suptask.queueId: The inbox tickets are raised in.
# default: ""
SUPTASK_QUEUE_ID=

# ticketing.suptask.requesterId: The chat user id automated tickets are raised as, usually the IT owner.
# default: ""
SUPTASK_REQUESTER_ID=

# ticketing.suptask.starterFormId: The new-starter form. Only a ticket raised on this form may open the activation gate.
# default: ""
SUPTASK_STARTER_FORM_ID=

# ticketing.suptask.leaverFormId: The form leaver tickets are raised on. Blank raises them with no form.
# default: ""
SUPTASK_LEAVER_FORM_ID=

# ownerNotifications.enabled: Tell each platform owner in the register when somebody leaves.
# default: false
OWNER_NOTIFICATIONS=

# ownerNotifications.goLiveDate: Required when enabled. Nobody whose leaving date is before this is ever notified, so switching the feature on cannot blast every owner about every leaver in the history.
# default: null
OWNER_NOTIFICATIONS_GO_LIVE=

# ownerNotifications.register.path: CSV with a header row, or JSON. Required when enabled.
# default: ""
SAAS_REGISTER_PATH=

# devices.dispositionDefault: What happens to a device when nobody says otherwise.
# default: "return_to_pool"
DEVICE_DISPOSITION_DEFAULT=

# devices.uninstallTriggers.windows: Command trigger name. Null refuses handover on this platform.
# default: null
DEVICE_UNINSTALL_TRIGGER_WINDOWS=

# devices.uninstallTriggers.darwin: Command trigger name. Null refuses handover on this platform.
# default: null
DEVICE_UNINSTALL_TRIGGER_MACOS=

# devices.uninstallTriggers.linux: Command trigger name. Null refuses handover on this platform.
# default: null
DEVICE_UNINSTALL_TRIGGER_LINUX=

# devices.agentQuietMinutes: Last contact must be frozen this long before a device record is deleted, so the removal is confirmed by silence rather than by an exit code.
# default: 10
DEVICE_AGENT_QUIET_MIN=

# devices.staleContactWarnMin: Preflight warns when a device has not been heard from for this long.
# default: 60
DEVICE_STALE_CONTACT_WARN_MIN=

# devices.purgeTelemetryHistory: Irreversible. Requires an explicit acknowledgement at the call site as well.
# default: false
DEVICE_PURGE_TELEMETRY=

# devices.receipt.holdMs: How long to hold the association after firing. A short hold loses the work on any device that was not connected at that instant.
# default: 120000
DEVICE_HOLD_MS=

# devices.receipt.pollMs: Result polling interval.
# default: 15000
DEVICE_POLL_MS=

# devices.receipt.timeoutMs: Give up waiting for a receipt. Never read a timeout as success.
# default: 600000
DEVICE_RECEIPT_TIMEOUT_MS=

# devices.fleet.url: Optional host-inventory API. Null disables the adapter.
# default: null
FLEET_API_URL=

# devices.fleet.token: Optional host-inventory token.
# SECRET: the value belongs in your secret manager, not in a repository.
# default: null
FLEET_API_TOKEN=

# notify.adapters: Where notifications go. Console is the default so the first run needs no credential.
# default: ["console"]
NOTIFY_ADAPTERS=

# notify.templatesDir: A folder of your own message wording. A file named like a built-in template (day0-manager.md, joiner-welcome.md and so on) replaces it; the rest keep the built-in text. Checked at start-up: an unknown file name or a placeholder the message does not supply refuses to start.
# default: null
NOTIFY_TEMPLATES_DIR=

# notify.weeklyReraiseDay: A standing problem is re-raised once on this weekday. Once, not on every run of that weekday: a weekday test is true for all of it.
# default: "monday"
NOTIFY_WEEKLY_RERAISE_DAY=

# notify.slack.botToken: Bot token, as a secret reference.
# SECRET: the value belongs in your secret manager, not in a repository.
# default: null
SLACK_BOT_TOKEN=

# notify.slack.itChannelId: Channel the IT summary is posted to.
# default: null
SLACK_JML_CHANNEL_ID=

# notify.email.itMailbox: Mailbox the IT summary is sent to.
# default: null
IT_SUPPORT_EMAIL=

# audit.minimisePii: Store addresses as a salted hash. An audit log is kept for years and does not need to be a staff directory.
# default: true
AUDIT_MINIMISE_PII=

# audit.salt: Hash salt. Required when minimisePii is true.
# SECRET: the value belongs in your secret manager, not in a repository.
# default: null
JML_AUDIT_SALT=

# audit.jsonl.dir: Directory for the append-only log files.
# default: "./audit"
AUDIT_DIR=

# audit.loki.enabled: Also push audit rows to a log aggregator.
# default: false
AUDIT_LOKI_ENABLED=

# audit.loki.url: Push endpoint.
# default: null
LOKI_PUSH_URL=

# audit.loki.authHeader: Authorization header value, as a secret reference.
# SECRET: the value belongs in your secret manager, not in a repository.
# default: null
LOKI_AUTH_HEADER=

# liveness.healthchecksPingUrl: Dead-man ping URL. The URL is itself the credential, so it is a secret reference. Pinged only after a notification is proven delivered.
# SECRET: the value belongs in your secret manager, not in a repository.
# default: null
HC_PING_JML=

# server.bind: Where the sidecar listens. Not published to the host in the shipped compose file.
# default: "0.0.0.0:8787"
JML_SERVER_BIND=

# server.token: Bearer token for the sidecar. At least 32 bytes; compared in constant time.
# SECRET: the value belongs in your secret manager, not in a repository.
JML_API_TOKEN=
