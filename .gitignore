# Secrets and local config — never commit
.env
.env.*
!.env.example
*.local.json
# Your own configuration. It holds references rather than values, but it also
# holds your organisation name, domains and mailboxes, which is exactly what
# the identifier gate exists to keep out of a public repository. The generated
# example says both files are gitignored, so they are.
/jml.config.yaml
# Literal strings an operator never wants published. A committed denylist
# would publish the very names it exists to block.
tools/lint/denylist.local.txt
.dev.vars
credentials.json
service-account*.json
*.pem
*.key
op_env
.op_env

# Local state
*.sqlite
*.sqlite3
*.db
data/
audit/*.jsonl
!audit/.gitkeep

# Build and deps
node_modules/
dist/
build/
coverage/
*.tsbuildinfo

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp

# Terraform (never ship state or tfvars)
*.tfvars
!*.tfvars.example
*.tfstate
*.tfstate.*
.terraform/
